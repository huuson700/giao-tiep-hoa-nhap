rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRoomMember(roomData) {
      return signedIn()
        && roomData.memberIds is list
        && roomData.memberIds.hasAny([request.auth.uid]);
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80;
      allow get, list: if isRoomMember(resource.data);
      allow update: if signedIn()
        && resource.data.memberIds is list
        && !resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.size() <= 50;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isRoomMember(get(/databases/$(database)/documents/rooms/$(roomId)).data);
        allow create: if isRoomMember(get(/databases/$(database)/documents/rooms/$(roomId)).data)
          && request.resource.data.keys().hasOnly(['text', 'senderId', 'senderEmail', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderEmail == request.auth.token.email
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Invite documents contain only a random code mapping to a room ID, not messages or profile data.
    // Signed-in users can resolve a code; room membership and message reads remain separately protected.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['roomId', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.createdAt == request.time
        && isRoomMember(get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data);
      allow update, delete: if false;
    }
  }
}
