name: Inspect Android Project

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  inspect:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check uploaded ZIP
        run: |
          echo "=== ZIP FILE ==="
          ls -lh Giao_Tiep_Hoa_Nhap_Android_Starter.zip
          echo "=== ZIP CONTENTS ==="
          unzip -l Giao_Tiep_Hoa_Nhap_Android_Starter.zip

      - name: Extract and inspect
        run: |
          mkdir extracted
          unzip -q Giao_Tiep_Hoa_Nhap_Android_Starter.zip -d extracted
          echo "=== PROJECT FILES ==="
          find extracted -type f | sort
          echo "=== GRADLE CONFIGURATION ==="
          find extracted -type f \( \
            -name settings.gradle -o \
            -name settings.gradle.kts -o \
            -name build.gradle -o \
            -name build.gradle.kts -o \
            -name gradle.properties -o \
            -name gradlew \
          \) -print
